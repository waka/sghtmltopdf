#: src/migration/wkhtmltopdf.md:75
msgid "画像の再エンコード: `--image-quality`・`--image-dpi`"
msgstr "Re-encoding images: `--image-quality`, `--image-dpi`"

#: src/migration/wkhtmltopdf.md:76
msgid ""

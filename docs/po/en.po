msgstr ""
"A bad option: an unknown key, a malformed value, or an option that is not "
"supported"

#: src/usage/ruby_rails.md:118
msgid "`Sghtmltopdf::InputError`"
msgstr "`Sghtmltopdf::InputError`"

#: src/usage/ruby_rails.md:118
msgid "入力や出力ファイルの読み書きに失敗した"
msgstr "Reading the input or writing the output failed"

#: src/usage/ruby_rails.md:119

#: src/migration/wkhtmltopdf.md:73
msgid "PDFアウトライン: `--outline`・`--outline-depth`・`--dump-outline`"
msgstr "PDF outlines: `--outline`, `--outline-depth`, `--dump-outline`"

#: src/migration/wkhtmltopdf.md:74
msgid ""
"XSLT: `--xsl-style-sheet`・`--dump-default-toc-xsl`(目次は内蔵テンプレート + "

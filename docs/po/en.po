#: src/migration/wkhtmltopdf.md:72
msgid ""
"JavaScript関連: `--enable-javascript`・`--javascript-delay`・`--run-script`・"
"`--window-status`・`--debug-javascript`・`--stop-slow-scripts`(JS実行は設計上"
"の非目標)"
msgstr ""
"JavaScript: `--enable-javascript`, `--javascript-delay`, `--run-script`, `--"

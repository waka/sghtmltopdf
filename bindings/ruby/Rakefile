# frozen_string_literal: true

require "bundler/gem_tasks"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("sghtmltopdf.gemspec")

# The extension task is named after the gem, because that name decides the built library
# (`lib/sghtmltopdf/sghtmltopdf.so`) and the `Init_sghtmltopdf` entry point. rb_sys also
# uses it to look the crate up with `cargo metadata`, and there the Cargo package is
# `sghtmltopdf-ruby`: the core crate is published to crates.io as `sghtmltopdf`, and two
# packages of the same name cannot be written to one lockfile. Only the lookup is redirected.
class ExtensionTask < RbSys::ExtensionTask
  CARGO_PACKAGE = "sghtmltopdf-ruby"

  def cargo_metadata
    @cargo_metadata ||= RbSys::Cargo::Metadata.new_or_inferred(CARGO_PACKAGE)
  end
end

ExtensionTask.new("sghtmltopdf", GEMSPEC) do |ext|
  ext.lib_dir = "lib/sghtmltopdf"
end

# Cross-built extensions are already staged for each Ruby ABI. The packaging
# task must not also compile an extension for the container's host Ruby.
if ENV["RUBY_TARGET"]
  host_binary = File.join("lib", "sghtmltopdf", "sghtmltopdf.#{RbConfig::CONFIG["DLEXT"]}")
  Rake::Task[host_binary].clear if Rake::Task.task_defined?(host_binary)
end

begin
  require "rspec/core/rake_task"
  RSpec::Core::RakeTask.new(:spec)
  task spec: :compile
  task default: %i[compile spec]
rescue LoadError
  task default: :compile
end

# The `release` task from `bundler/gem_tasks` does:
#   build one source gem -> create a git tag -> push
# but cross-building in CI needs:
#   build one source gem -> create a git tag -> push -> build precompiled gems -> push
# so we replace the `release` task.
Rake::Task["release"].clear

desc "Push every gem under pkg/ to rubygems.org (used from CI)"
task :release do
  gems = Dir["pkg/*.gem"].sort
  raise "no gems in pkg/. Run the cross build and `rake build` first" if gems.empty?

  gems.each do |path|
    puts "pushing #{path}"
    sh("gem", "push", path)
  end
end
